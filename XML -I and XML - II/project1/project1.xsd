<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- SIM Size Restriction -->
    <xs:simpleType name="SIMSizeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Normal"/>
            <xs:enumeration value="Micro"/>
            <xs:enumeration value="Nano"/>
            <xs:enumeration value="micro"/>
            <xs:enumeration value="nano"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Store Name Restriction -->
    <xs:simpleType name="StoreNameType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="store1"/>
            <xs:enumeration value="store2"/>
            <xs:enumeration value="store3"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Root Element -->
    <xs:element name="MobileSales">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Mobile" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="ModelID" type="xs:string"/>
                            <xs:element name="Brand" type="xs:string"/>
                            <xs:element name="Price" type="xs:decimal"/>
                            <xs:element name="Color" type="xs:string"/>
                            <xs:element name="SIMSize" type="SIMSizeType"/>
                            <xs:element name="Memory" type="xs:string"/>
                            <xs:element name="Camera" type="xs:string"/>
                            <xs:element name="TouchScreen" type="xs:string"/>
                            <xs:element name="NoSold" type="xs:integer"/>
                            <xs:element name="storeName" type="StoreNameType"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>